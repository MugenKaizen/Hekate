#!/usr/bin/env sh
# Hekate cross-harness job runner. No daemon, MCP server, eval, or dependencies.
#
# Canonical job-directory layout (must match hekate-agent.ps1 exactly; a job
# created by one implementation must be fully readable by the other):
#   status        - queued | running | completed | failed | stopped | orphaned
#   profile       - resolved profile name, or "none"
#   harness       - resolved harness name
#   model         - resolved model token
#   effort        - resolved effort token
#   cwd           - absolute working directory for the job
#   task.md       - the task/prompt text delivered to the harness
#   command.txt   - the resolved command line, for debugging
#   stdout.log    - harness stdout (streamed incrementally where possible)
#   stderr.log    - harness stderr (streamed incrementally where possible)
#   worker-pid    - PID of the detached worker process (this script, __worker)
#   child-pid     - PID of the harness child process launched by the worker
#   worker-token  - durable identity marker ("<pid>:<start-time>") used to
#                   verify worker-pid ownership before signaling it
#   started-at    - UTC timestamp the worker began running the harness
#   finished-at   - UTC timestamp the worker observed the harness exit
#   exit-code     - the harness process's exit code
#   launcher-pid  - PID of the `nohup ... &` launcher (background runs only)
set -eu

SELF="$0"
case "$SELF" in /*) ;; *) SELF="$(pwd)/$SELF" ;; esac

usage() {
  cat <<'EOF'
Usage: hekate-agent <command> [options]

Commands:
  doctor [<harness>|--strict]    Check configured harness executables
  harnesses                      List configured harnesses and defaults
  profiles                       List named task-routing profiles
  models <harness>               Best-effort model discovery/help
  config show                    Show effective local selection
  config use <harness> [--model M] [--effort E]
  config use-profile <profile>   Select a local default profile
  config clear                   Remove personal overrides
  run [--profile P | --harness H] [--model M] [--effort E] [--cwd DIR]
      (--task TEXT | --task-file FILE) [--name NAME] [--foreground]
  list                           List jobs
  status <job-id>                Show job state and metadata
  logs <job-id> [--stderr] [--follow]
  wait <job-id> [--timeout SEC]  Wait and return the harness exit code
  result <job-id>                Print final stdout
  stop <job-id>                  Terminate a running job

Runs are backgrounded by default. Configuration is discovered by walking up
from the current directory to .workflow/orchestration.yml.
EOF
}

die() { printf 'hekate-agent: %s\n' "$*" >&2; exit 2; }
warn() { printf 'hekate-agent: warning: %s\n' "$*" >&2; }

find_root() {
  p="$(pwd -P)"
  while :; do
    if [ -f "$p/.workflow/orchestration.yml" ]; then printf '%s\n' "$p"; return 0; fi
    [ "$p" != / ] || return 1
    p="$(dirname "$p")"
  done
}

ROOT="${HEKATE_ROOT:-}"
if [ -z "$ROOT" ]; then ROOT="$(find_root)" || die "cannot find .workflow/orchestration.yml"; fi
ROOT="$(CDPATH= cd -- "$ROOT" && pwd -P)"
CONFIG="$ROOT/.workflow/orchestration.yml"
LOCAL_CONFIG="$ROOT/.workflow/orchestration.local.yml"

unquote() {
  printf '%s\n' "$1" | awk '{ v=$0; sub(/^[[:space:]]+/,"",v); sub(/[[:space:]]+$/,"",v); if ((substr(v,1,1)=="\"" && substr(v,length(v),1)=="\"") || (substr(v,1,1)=="\047" && substr(v,length(v),1)=="\047")) v=substr(v,2,length(v)-2); print v }'
}

# check_no_tab_indent: refuse tab-indented YAML with a clear, immediate error
# instead of letting the indentation-sensitive parser below silently return
# nothing for lines it cannot classify. Must be called at top level (not
# inside a command substitution) so `die` actually terminates the script.
check_no_tab_indent() {
  f="$1"
  [ -f "$f" ] || return 0
  line="$(awk '/^\t/ { print NR; exit } /^ *\t/ { print NR; exit }' "$f")"
  [ -z "$line" ] || die "tab-indented line $line in $f is not supported; use spaces for indentation"
}

# Shared awk parser core. Indentation depth is measured relative to the
# section/item it is nested under (whatever width the file actually uses),
# rather than a hardcoded column count, so 2-space, 4-space, or otherwise
# consistently-indented YAML all parse correctly. A found key is reported as
# "F:<value>" (value may be empty); an absent key prints nothing, so callers
# can distinguish "key absent" from "key present but empty".
_indent_awk_prelude='
  function indent_of(line,   n) { n = match(line, /[^ ]/); return (n ? n - 1 : length(line)) }
'

top_value() {
  file="$1" key="$2"
  [ -f "$file" ] || return 0
  raw="$(awk -v key="$key" '$0 ~ "^" key ":[[:space:]]*" { v=$0; sub("^" key ":[[:space:]]*","",v); sub(/[[:space:]]+#.*/,"",v); print v; exit }' "$file")"
  [ -z "$raw" ] || unquote "$raw"
}

_nested_raw() {
  file="$1" section="$2" item="$3" key="$4"
  [ -f "$file" ] || return 0
  awk -v section="$section" -v item="$item" -v key="$key" "$_indent_awk_prelude"'
    BEGIN { state = 0; item_indent = ""; key_indent = "" }
    {
      raw = $0
      if (raw ~ /^[[:space:]]*$/ || raw ~ /^[[:space:]]*#/) next
      ind = indent_of(raw)
      content = raw; sub(/^ */, "", content)
      if (state == 0) {
        if (ind == 0 && content == section ":") state = 1
        next
      }
      # Leaving the target item scope (sibling item, or dedent to a
      # top-level key handled just below) falls back to item-scanning for
      # this same line, rather than abandoning the whole section outright.
      if (state == 2 && ind <= item_indent) { state = 1; item_indent = ""; key_indent = "" }
      if (state == 1) {
        if (ind == 0) { state = 0; next }
        if (item_indent == "" || ind == item_indent) {
          if (content == item ":") { item_indent = ind; state = 2 }
          else { item_indent = ind }
        }
        next
      }
      if (state == 2) {
        if (key_indent == "") key_indent = ind
        if (ind == key_indent && content ~ "^" key ":") {
          v = content
          sub("^" key ":[[:space:]]*", "", v)
          sub(/[[:space:]]+#.*/, "", v)
          print "F:" v
          exit
        }
        next
      }
    }
  ' "$file"
}

nested_value() {
  raw="$(_nested_raw "$@")"
  case "$raw" in
    F:*) unquote "${raw#F:}" ;;
    *) printf '\n' ;;
  esac
}

nested_present() {
  raw="$(_nested_raw "$@")"
  case "$raw" in F:*) return 0 ;; *) return 1 ;; esac
}

harness_list() {
  file="$1" item="$2" list_key="$3"
  [ -f "$file" ] || return 0
  awk -v item="$item" -v list_key="$list_key" "$_indent_awk_prelude"'
    BEGIN { state = 0; item_indent = ""; key_indent = ""; list_indent = "" }
    {
      raw = $0
      if (raw ~ /^[[:space:]]*$/ || raw ~ /^[[:space:]]*#/) next
      ind = indent_of(raw)
      content = raw; sub(/^ */, "", content)
      if (state == 0) {
        if (ind == 0 && content == "harnesses:") state = 1
        next
      }
      # Cascade dedents through as many scopes as needed on this one line
      # (e.g. a list ending at the same moment its owning item ends).
      if (state == 3 && ind <= key_indent) { state = 2; key_indent = ""; list_indent = "" }
      if (state == 2 && ind <= item_indent) { state = 1; item_indent = ""; key_indent = "" }
      if (state == 1) {
        if (ind == 0) { state = 0; next }
        if (item_indent == "" || ind == item_indent) {
          if (content == item ":") { item_indent = ind; state = 2 }
          else { item_indent = ind }
        }
        next
      }
      if (state == 2) {
        if (key_indent == "" || ind == key_indent) {
          if (content ~ "^" list_key ":[[:space:]]*$") { key_indent = ind; state = 3; list_indent = "" }
          else { key_indent = ind }
        }
        next
      }
      if (state == 3) {
        if (list_indent == "") list_indent = ind
        if (ind == list_indent && content ~ /^-[[:space:]]*/) {
          v = content; sub(/^-[[:space:]]*/, "", v)
          if ((substr(v,1,1)=="\"" && substr(v,length(v),1)=="\"") || (substr(v,1,1)=="\047" && substr(v,length(v),1)=="\047")) v=substr(v,2,length(v)-2)
          print v
        }
        next
      }
    }
  ' "$file"
}

harness_args() { harness_list "$1" "$2" args; }

section_names() {
  file="$1" section="$2"
  [ -f "$file" ] || return 0
  awk -v section="$section" "$_indent_awk_prelude"'
    BEGIN { state = 0; item_indent = "" }
    {
      raw = $0
      if (raw ~ /^[[:space:]]*$/ || raw ~ /^[[:space:]]*#/) next
      ind = indent_of(raw)
      content = raw; sub(/^ */, "", content)
      if (state == 0) {
        if (ind == 0 && content == section ":") state = 1
        next
      }
      if (state == 1) {
        if (ind == 0) { state = 0; next }
        if (item_indent == "") item_indent = ind
        if (ind == item_indent && content ~ /^[A-Za-z0-9_.-]+:[[:space:]]*$/) {
          v = content; sub(/:[[:space:]]*$/, "", v); print v
        }
      }
    }
  ' "$file"
}

harness_names() { section_names "$CONFIG" harnesses; }

profile_names() {
  { section_names "$CONFIG" profiles; section_names "$LOCAL_CONFIG" profiles; } | awk '$0 != "none" && $0 != "null" && !seen[$0]++'
}

valid_token() {
  case "$1" in *"
"*|*"
"*) return 1 ;; esac
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:@/+,-]*$'
}
valid_id() {
  case "$1" in *"
"*|*"
"*) return 1 ;; esac
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]*$'
}
valid_profile_id() {
  valid_id "$1" || return 1
  case "$1" in none|null) return 1 ;; *) return 0 ;; esac
}
require_harness() {
  valid_id "$1" || die "invalid harness name"
  nested_present "$CONFIG" harnesses "$1" command || die "unknown harness: $1"
  nested_value "$CONFIG" harnesses "$1" command | grep -q . || die "harness $1 has an empty command"
}

local_or_base_top() {
  key="$1"; v="$(top_value "$LOCAL_CONFIG" "$key")"; [ -n "$v" ] || v="$(top_value "$CONFIG" "$key")"; printf '%s\n' "$v"
}

effective_default_profile() {
  v="$(local_or_base_top default_profile)"
  case "$v" in ''|null|none) printf '\n' ;; *) printf '%s\n' "$v" ;; esac
}

profile_value() {
  profile="$1" key="$2"
  v="$(nested_value "$LOCAL_CONFIG" profiles "$profile" "$key")"
  [ -n "$v" ] || v="$(nested_value "$CONFIG" profiles "$profile" "$key")"
  printf '%s\n' "$v"
}

profile_present() {
  profile="$1"
  nested_present "$LOCAL_CONFIG" profiles "$profile" harness && return 0
  nested_present "$CONFIG" profiles "$profile" harness
}

require_profile() {
  valid_profile_id "$1" || die "invalid or reserved profile name: $1"
  profile_present "$1" || die "unknown profile: $1"
  profile_value "$1" harness | grep -q . || die "profile $1 has an empty harness"
}

default_value() {
  harness="$1" key="$2"
  v="$(nested_value "$LOCAL_CONFIG" defaults "$harness" "$key")"
  [ -n "$v" ] || v="$(nested_value "$CONFIG" harnesses "$harness" "default_$key")"
  printf '%s\n' "$v"
}

jobs_dir() {
  d="$(top_value "$CONFIG" jobs_dir)"; [ -n "$d" ] || d=.workflow/runs
  case "$d" in /*) printf '%s\n' "$d" ;; *) printf '%s/%s\n' "$ROOT" "$d" ;; esac
}

atomic_write() { dst="$1"; shift; tmp="$dst.tmp.$$"; printf '%s\n' "$*" > "$tmp"; mv "$tmp" "$dst"; }
read_field() { [ -f "$1/$2" ] && cat "$1/$2" || true; }

canonical_cwd() {
  [ -d "$1" ] || die "cwd does not exist: $1"
  (CDPATH= cd -- "$1" && pwd -P)
}

ensure_allowed_cwd() {
  c="$1" allow="$(top_value "$CONFIG" allow_external_cwd)"
  [ "$allow" = true ] && return 0
  case "$c/" in "$ROOT/"*) ;; *) die "cwd must be inside project root ($ROOT)" ;; esac
}

replace_arg() {
  value="$1"
  case "$value" in
    '{model}') printf '%s\n' "$MODEL" ;;
    '{effort}') printf '%s\n' "$EFFORT" ;;
    '{prompt_file}') printf '%s\n' "$TASK_FILE" ;;
    '{session_id}') printf '%s\n' "$SESSION_ID" ;;
    '{cwd}') printf '%s\n' "$JOB_CWD" ;;
    *'{model}'*) pre=${value%%\{model\}*}; post=${value#*\{model\}}; printf '%s%s%s\n' "$pre" "$MODEL" "$post" ;;
    *'{effort}'*) pre=${value%%\{effort\}*}; post=${value#*\{effort\}}; printf '%s%s%s\n' "$pre" "$EFFORT" "$post" ;;
    *'{prompt_file}'*) pre=${value%%\{prompt_file\}*}; post=${value#*\{prompt_file\}}; printf '%s%s%s\n' "$pre" "$TASK_FILE" "$post" ;;
    *'{session_id}'*) pre=${value%%\{session_id\}*}; post=${value#*\{session_id\}}; printf '%s%s%s\n' "$pre" "$SESSION_ID" "$post" ;;
    *'{cwd}'*) pre=${value%%\{cwd\}*}; post=${value#*\{cwd\}}; printf '%s%s%s\n' "$pre" "$JOB_CWD" "$post" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

invoke_job() {
  run="$1"
  HARNESS="$(read_field "$run" harness)"; MODEL="$(read_field "$run" model)"; EFFORT="$(read_field "$run" effort)"; TASK_FILE="$run/task.md"
  SESSION_ID="$(basename "$run")"; JOB_CWD="$(read_field "$run" cwd)"
  command_name="$(nested_value "$CONFIG" harnesses "$HARNESS" command)"
  delivery="$(nested_value "$CONFIG" harnesses "$HARNESS" prompt_delivery)"
  args_file="$run/args.raw"
  harness_args "$CONFIG" "$HARNESS" > "$args_file"
  set --
  while IFS= read -r raw || [ -n "$raw" ]; do
    arg="$(replace_arg "$raw")"
    [ -n "$arg" ] && set -- "$@" "$arg"
  done < "$args_file"
  rm -f "$args_file"
  {
    printf '%s' "$command_name"
    for arg in "$@"; do printf ' [%s]' "$arg"; done
    printf '\n'
  } > "$run/command.txt"
  case "$delivery" in
    stdin) "$command_name" "$@" < "$TASK_FILE" ;;
    argument) prompt="$(cat "$TASK_FILE")"; "$command_name" "$@" "$prompt" ;;
    file) "$command_name" "$@" ;;
    *) die "unsupported prompt_delivery for $HARNESS: $delivery" ;;
  esac
}

worker_start_time() {
  pid="$1"
  command -v ps >/dev/null 2>&1 || return 1
  ps -p "$pid" -o lstart= 2>/dev/null | awk '{ $1=$1; print }'
}

worker() {
  run="$1"; atomic_write "$run/status" running; atomic_write "$run/worker-pid" "$$"; atomic_write "$run/started-at" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  token_time="$(worker_start_time "$$" || true)"
  atomic_write "$run/worker-token" "$$:$token_time"
  child=""
  on_term() { [ -z "$child" ] || kill -TERM "$child" 2>/dev/null || true; atomic_write "$run/status" stopped; exit 143; }
  trap on_term INT TERM HUP
  set +e
  (cd "$(read_field "$run" cwd)" && invoke_job "$run") > "$run/stdout.log" 2> "$run/stderr.log" &
  child=$!; atomic_write "$run/child-pid" "$child"; wait "$child"; code=$?
  set -e
  atomic_write "$run/exit-code" "$code"; atomic_write "$run/finished-at" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ "$code" -eq 0 ]; then atomic_write "$run/status" completed; else atomic_write "$run/status" failed; fi
  return "$code"
}

write_local_config() {
  selected="$1" selected_model="$2" selected_effort="$3" selected_profile="$4"
  tmp="$LOCAL_CONFIG.tmp.$$"; preserved="$LOCAL_CONFIG.profiles.$$"
  if [ -f "$LOCAL_CONFIG" ]; then
    awk '/^profiles:[[:space:]]*$/{p=1;print;next} p&&/^[^[:space:]]/{exit} p{print}' "$LOCAL_CONFIG" > "$preserved"
  else : > "$preserved"; fi
  {
    printf '# Personal overrides; generated by hekate-agent.\n'
    printf 'schema_version: 2\n'
    printf 'enabled: true\n'
    printf 'default_harness: %s\n' "$selected"
    printf 'default_profile: %s\n' "$selected_profile"
    printf 'defaults:\n'
    for h in $(harness_names); do
      m="$(default_value "$h" model)"; e="$(default_value "$h" effort)"
      if [ "$h" = "$selected" ]; then [ -z "$selected_model" ] || m="$selected_model"; [ -z "$selected_effort" ] || e="$selected_effort"; fi
      printf '  %s:\n    model: "%s"\n    effort: "%s"\n' "$h" "$m" "$e"
    done
    if [ -s "$preserved" ]; then printf '\n'; cat "$preserved"; fi
  } > "$tmp"
  rm -f "$preserved"; mv "$tmp" "$LOCAL_CONFIG"
}

show_config() {
  printf 'project: %s\n' "$ROOT"
  printf 'enabled: %s\n' "$(local_or_base_top enabled)"
  printf 'default_harness: %s\n' "$(local_or_base_top default_harness)"
  profile="$(effective_default_profile)"; [ -n "$profile" ] || profile=none
  printf 'default_profile: %s\n' "$profile"
  printf 'local_override: %s\n' "$LOCAL_CONFIG"
  for h in $(harness_names); do printf '%-10s model=%s effort=%s\n' "$h" "$(default_value "$h" model)" "$(default_value "$h" effort)"; done
}

job_path() { valid_id "$1" || die "invalid job id"; p="$(jobs_dir)/$1"; [ -d "$p" ] || die "unknown job: $1"; printf '%s\n' "$p"; }

# pid_is_worker verifies that $pid is still the same process that was
# recorded as the worker for job $run, guarding against PID reuse (a dead
# worker's PID being recycled by an unrelated process before we get to
# signal it). Primary check: compare the process's current start time
# against the "worker-token" recorded when the worker started (durable,
# independent of argv/command-line contents). Fallback, only used when the
# primary check is unavailable (no ps/lstart support, or a job directory
# created before worker-token existed): substring-match the command line, as
# before. If neither check can positively establish ownership, refuse.
pid_is_worker() {
  pid="$1" run="$2"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  token="$(read_field "$run" worker-token)"
  if [ -n "$token" ]; then
    token_pid="${token%%:*}"
    token_time="${token#*:}"
    if [ "$token_pid" = "$pid" ] && [ -n "$token_time" ]; then
      current_time="$(worker_start_time "$pid" || true)"
      if [ -n "$current_time" ]; then
        [ "$current_time" = "$token_time" ] && return 0 || return 1
      fi
    elif [ "$token_pid" = "$pid" ]; then
      # token exists for this pid but we could not capture a start time at
      # worker start (no ps/lstart support) — fall through to the heuristic.
      :
    else
      # token belongs to a different pid than the one we were asked about.
      return 1
    fi
  fi
  command -v ps >/dev/null 2>&1 || return 1
  line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  case "$line" in *"hekate-agent"*"__worker"*"$run"*) return 0 ;; *) return 1 ;; esac
}

effective_state() {
  run="$1"; state="$(read_field "$run" status)"
  if [ "$state" = running ] || [ "$state" = queued ]; then
    worker_pid="$(read_field "$run" worker-pid)"
    if [ -n "$worker_pid" ] && ! pid_is_worker "$worker_pid" "$run"; then
      state=orphaned; atomic_write "$run/status" orphaned
    fi
  fi
  printf '%s\n' "$state"
}

status_job() {
  run="$(job_path "$1")"; state="$(effective_state "$run")"
  printf 'id: %s\nstatus: %s\nprofile: %s\nharness: %s\nmodel: %s\neffort: %s\ncwd: %s\n' "$1" "$state" "$(read_field "$run" profile)" "$(read_field "$run" harness)" "$(read_field "$run" model)" "$(read_field "$run" effort)" "$(read_field "$run" cwd)"
  [ ! -f "$run/exit-code" ] || printf 'exit_code: %s\n' "$(cat "$run/exit-code")"
  [ ! -f "$run/started-at" ] || printf 'started_at: %s\n' "$(cat "$run/started-at")"
  [ ! -f "$run/finished-at" ] || printf 'finished_at: %s\n' "$(cat "$run/finished-at")"
}

run_command() {
  PROFILE=""; PROFILE_EXPLICIT=0; HARNESS=""; HARNESS_EXPLICIT=0; MODEL=""; MODEL_SELECTED=0; EFFORT=""; EFFORT_SELECTED=0
  CWD="$ROOT"; TASK=""; SOURCE_FILE=""; NAME=""; FOREGROUND=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --profile) [ "$#" -ge 2 ] || die "--profile needs a value"; PROFILE="$2"; PROFILE_EXPLICIT=1; shift 2 ;;
      --harness) [ "$#" -ge 2 ] || die "--harness needs a value"; HARNESS="$2"; HARNESS_EXPLICIT=1; shift 2 ;;
      --model) [ "$#" -ge 2 ] || die "--model needs a value"; MODEL="$2"; MODEL_SELECTED=1; shift 2 ;;
      --effort) [ "$#" -ge 2 ] || die "--effort needs a value"; EFFORT="$2"; EFFORT_SELECTED=1; shift 2 ;;
      --cwd) [ "$#" -ge 2 ] || die "--cwd needs a value"; CWD="$2"; shift 2 ;;
      --task) [ "$#" -ge 2 ] || die "--task needs a value"; TASK="$2"; shift 2 ;;
      --task-file) [ "$#" -ge 2 ] || die "--task-file needs a value"; SOURCE_FILE="$2"; shift 2 ;;
      --name) [ "$#" -ge 2 ] || die "--name needs a value"; NAME="$2"; shift 2 ;;
      --foreground) FOREGROUND=1; shift ;;
      *) die "unknown run option: $1" ;;
    esac
  done
  [ "$PROFILE_EXPLICIT" -eq 0 ] || [ "$HARNESS_EXPLICIT" -eq 0 ] || die "use either --profile or --harness"
  [ "$(local_or_base_top enabled)" = true ] || die "orchestration is disabled; run: hekate-agent config use <harness>"

  if [ "$PROFILE_EXPLICIT" -eq 0 ] && [ "$HARNESS_EXPLICIT" -eq 0 ]; then PROFILE="$(effective_default_profile)"; fi
  if [ -n "$PROFILE" ]; then
    require_profile "$PROFILE"
    HARNESS="$(profile_value "$PROFILE" harness)"
    if [ "$MODEL_SELECTED" -eq 0 ]; then MODEL="$(profile_value "$PROFILE" model)"; [ -z "$MODEL" ] || MODEL_SELECTED=1; fi
    if [ "$EFFORT_SELECTED" -eq 0 ]; then EFFORT="$(profile_value "$PROFILE" effort)"; [ -z "$EFFORT" ] || EFFORT_SELECTED=1; fi
  else
    PROFILE=none
    [ -n "$HARNESS" ] || HARNESS="$(local_or_base_top default_harness)"
  fi

  require_harness "$HARNESS"
  [ "$(nested_value "$CONFIG" harnesses "$HARNESS" enabled)" = true ] || die "harness is disabled: $HARNESS"
  [ -n "$MODEL" ] || MODEL="$(default_value "$HARNESS" model)"; [ -n "$EFFORT" ] || EFFORT="$(default_value "$HARNESS" effort)"
  valid_token "$MODEL" || die "model contains unsupported characters"; valid_token "$EFFORT" || die "effort contains unsupported characters"
  if [ "$MODEL_SELECTED" -eq 1 ] && [ "$(nested_value "$CONFIG" harnesses "$HARNESS" supports_model)" != true ]; then die "$HARNESS does not support model selection"; fi
  if [ "$EFFORT_SELECTED" -eq 1 ] && [ "$(nested_value "$CONFIG" harnesses "$HARNESS" supports_effort)" != true ]; then die "$HARNESS does not support effort selection"; fi
  CWD="$(canonical_cwd "$CWD")"; ensure_allowed_cwd "$CWD"
  if [ -n "$SOURCE_FILE" ] && [ -n "$TASK" ]; then die "use either --task or --task-file"; fi
  if [ -n "$SOURCE_FILE" ]; then [ -f "$SOURCE_FILE" ] || die "task file not found"; else [ -n "$TASK" ] || die "--task or --task-file is required"; fi
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"; suffix="$$"; id="$stamp-$HARNESS-$suffix"
  [ -z "$NAME" ] || { valid_id "$NAME" || die "invalid job name"; id="$stamp-$NAME-$suffix"; }
  run="$(jobs_dir)/$id"; mkdir -p "$run"
  printf '%s\n' "$PROFILE" > "$run/profile"; printf '%s\n' "$HARNESS" > "$run/harness"; printf '%s\n' "$MODEL" > "$run/model"; printf '%s\n' "$EFFORT" > "$run/effort"; printf '%s\n' "$CWD" > "$run/cwd"; atomic_write "$run/status" queued
  if [ -n "$SOURCE_FILE" ]; then cp "$SOURCE_FILE" "$run/task.md"; else printf '%s\n' "$TASK" > "$run/task.md"; fi
  if [ "$FOREGROUND" -eq 1 ]; then
    set +e; worker "$run"; code=$?; set -e
    [ ! -f "$run/stdout.log" ] || cat "$run/stdout.log"
    [ ! -s "$run/stderr.log" ] || cat "$run/stderr.log" >&2
    return "$code"
  else
    HEKATE_ROOT="$ROOT" nohup "$SELF" __worker "$run" >/dev/null 2>&1 &
    atomic_write "$run/launcher-pid" "$!"; printf '%s\n' "$id"
  fi
}

check_no_tab_indent "$CONFIG"
check_no_tab_indent "$LOCAL_CONFIG"

cmd="${1:-help}"; [ "$#" -eq 0 ] || shift
case "$cmd" in
  help|-h|--help) usage ;;
  __worker) [ "$#" -eq 1 ] || exit 2; worker "$1" ;;
  doctor)
    strict=0; target=""
    [ "$#" -le 1 ] || die "doctor accepts one harness or --strict"
    if [ "$#" -eq 1 ]; then case "$1" in --strict) strict=1 ;; *) target="$1"; require_harness "$target" ;; esac; fi
    rc=0
    for h in $(harness_names); do
      [ -z "$target" ] || [ "$h" = "$target" ] || continue
      c="$(nested_value "$CONFIG" harnesses "$h" command)"; enabled="$(nested_value "$CONFIG" harnesses "$h" enabled)"
      if [ "$enabled" != true ]; then printf 'disabled disabled %-10s %s\n' "$h" "$c"; [ -z "$target" ] || rc=1
      elif command -v "$c" >/dev/null 2>&1; then printf 'ok       enabled  %-10s %s\n' "$h" "$(command -v "$c")"
      else printf 'missing  enabled  %-10s %s\n' "$h" "$c"; [ "$strict" -eq 0 ] && [ -z "$target" ] || rc=1
      fi
    done
    exit "$rc" ;;
  harnesses)
    for h in $(harness_names); do printf '%-10s command=%s model=%s effort=%s\n' "$h" "$(nested_value "$CONFIG" harnesses "$h" command)" "$(default_value "$h" model)" "$(default_value "$h" effort)"; done ;;
  profiles)
    for p in $(profile_names); do printf '%-14s harness=%s model=%s effort=%s\n' "$p" "$(profile_value "$p" harness)" "$(profile_value "$p" model)" "$(profile_value "$p" effort)"; done ;;
  models)
    [ "$#" -eq 1 ] || die "models requires a harness"; require_harness "$1"
    models_command="$(nested_value "$CONFIG" harnesses "$1" models_command)"
    [ -n "$models_command" ] || { printf 'No model discovery command configured for %s.\n' "$1"; exit 0; }
    set --
    models_args_file="$(jobs_dir)/.models-args.$$"; mkdir -p "$(jobs_dir)"; harness_list "$CONFIG" "$1" models_args > "$models_args_file"
    while IFS= read -r arg || [ -n "$arg" ]; do set -- "$@" "$arg"; done < "$models_args_file"; rm -f "$models_args_file"
    "$models_command" "$@" ;;
  config)
    sub="${1:-show}"; [ "$#" -eq 0 ] || shift
    case "$sub" in
      show) show_config ;;
      clear) rm -f "$LOCAL_CONFIG"; printf 'cleared %s\n' "$LOCAL_CONFIG" ;;
      use)
        [ "$#" -ge 1 ] || die "config use requires a harness"; h="$1"; shift; require_harness "$h"; m=""; e=""
        while [ "$#" -gt 0 ]; do case "$1" in --model) [ "$#" -ge 2 ] || die "--model needs value"; m="$2"; shift 2 ;; --effort) [ "$#" -ge 2 ] || die "--effort needs value"; e="$2"; shift 2 ;; *) die "unknown config option: $1" ;; esac; done
        [ -z "$m" ] || valid_token "$m" || die "invalid model"; [ -z "$e" ] || valid_token "$e" || die "invalid effort"
        [ -z "$m" ] || [ "$(nested_value "$CONFIG" harnesses "$h" supports_model)" = true ] || die "$h does not support model selection"
        [ -z "$e" ] || [ "$(nested_value "$CONFIG" harnesses "$h" supports_effort)" = true ] || die "$h does not support effort selection"
        write_local_config "$h" "$m" "$e" none; show_config ;;
      use-profile)
        [ "$#" -eq 1 ] || die "config use-profile requires one profile"
        p="$1"; require_profile "$p"; h="$(profile_value "$p" harness)"; require_harness "$h"
        [ "$(nested_value "$CONFIG" harnesses "$h" enabled)" = true ] || die "harness is disabled: $h"
        m="$(profile_value "$p" model)"; e="$(profile_value "$p" effort)"
        [ -z "$m" ] || [ "$(nested_value "$CONFIG" harnesses "$h" supports_model)" = true ] || die "$h does not support model selection"
        [ -z "$e" ] || [ "$(nested_value "$CONFIG" harnesses "$h" supports_effort)" = true ] || die "$h does not support effort selection"
        write_local_config "$h" "" "" "$p"; show_config ;;
      *) die "unknown config command: $sub" ;;
    esac ;;
  run) run_command "$@" ;;
  list)
    dir="$(jobs_dir)"; [ -d "$dir" ] || exit 0
    for run in "$dir"/*; do [ -d "$run" ] || continue; id="$(basename "$run")"; printf '%-34s %-10s %s\n' "$id" "$(read_field "$run" status)" "$(read_field "$run" harness)"; done ;;
  status) [ "$#" -eq 1 ] || die "status requires job id"; status_job "$1" ;;
  logs)
    [ "$#" -ge 1 ] || die "logs requires job id"; id="$1"; shift; stream=stdout.log; follow=0
    while [ "$#" -gt 0 ]; do case "$1" in --stderr) stream=stderr.log ;; --follow) follow=1 ;; *) die "unknown logs option: $1" ;; esac; shift; done
    run="$(job_path "$id")"; touch "$run/$stream"; if [ "$follow" -eq 1 ]; then tail -f "$run/$stream"; else cat "$run/$stream"; fi ;;
  wait)
    [ "$#" -ge 1 ] || die "wait requires job id"; id="$1"; shift; timeout=0
    while [ "$#" -gt 0 ]; do case "$1" in --timeout) [ "$#" -ge 2 ] || die "--timeout needs seconds"; timeout="$2"; shift 2 ;; *) die "unknown wait option: $1" ;; esac; done
    printf '%s' "$timeout" | grep -Eq '^[0-9]+$' || die "timeout must be a non-negative integer"
    run="$(job_path "$id")"; started="$(date +%s)"
    while :; do
      state="$(effective_state "$run")"; case "$state" in completed|failed|stopped|orphaned) break ;; esac
      if [ "$timeout" -gt 0 ] && [ $(( $(date +%s) - started )) -ge "$timeout" ]; then exit 124; fi
      sleep 1
    done
    code="$(read_field "$run" exit-code)"; [ -n "$code" ] || code=1; exit "$code" ;;
  result) [ "$#" -eq 1 ] || die "result requires job id"; run="$(job_path "$1")"; [ -f "$run/stdout.log" ] || die "job has no result yet"; cat "$run/stdout.log" ;;
  stop)
    [ "$#" -eq 1 ] || die "stop requires job id"; run="$(job_path "$1")"; state="$(effective_state "$run")"
    case "$state" in queued|running) ;; completed|failed|stopped|orphaned) die "job is not active: $state" ;; *) die "cannot safely stop job in state: $state" ;; esac
    worker_pid="$(read_field "$run" worker-pid)"
    pid_is_worker "$worker_pid" "$run" || { atomic_write "$run/status" orphaned; die "worker identity cannot be verified; refusing to signal PID"; }
    # Signal only the verified worker. Its TERM trap owns and terminates the
    # current harness child, avoiding stale child-PID reuse.
    kill -TERM "$worker_pid"
    i=0; while kill -0 "$worker_pid" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    [ "$(read_field "$run" status)" = stopped ] || atomic_write "$run/status" stopped ;;
  *) usage >&2; exit 2 ;;
esac
