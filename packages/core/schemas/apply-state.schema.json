{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hekate:schema:apply-state:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "created_parent_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "transaction_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"},
    "created_parent_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
