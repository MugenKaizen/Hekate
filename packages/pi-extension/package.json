  "description": "Mechanical Hekate policy enforcement for Pi sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MugenKaizen/Hekate.git",
    "directory": "packages/pi-extension"
  },
  "homepage": "https://github.com/MugenKaizen/Hekate#readme",
